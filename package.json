{
  "name": "scratches",
  "displayName": "scratches",
  "description": "Scratches is a Visual Studio Code extension designed to help you manage temporary or experimental files during your coding sessions. It provides a centralized storage solution for scratch files, enabling you to efficiently organize and access these files. With features like project-specific file management, shared files access, and comprehensive file operations, Scratches enhances your workflow by keeping your scratch files organized and easily accessible.",
  "version": "1.1.0",
  "repository": { "type": "git", "url": "https://github.com/savvarost/scratches.git" },
  "publisher": "scratches",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "Scratches",
      "properties": {
        "scratches.path": {
          "markdownDescription": "Directory where scratch files are stored. [Set Root Path](command:scratches.setRootPath)"
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "viewsWelcome",
        "contents": "Welcome to Scratches\n\n\nTo get started with the Scratches extension, you need to select a directory where all your scratch files will be stored. This directory acts as a central repository for all temporary or experimental files that you create during your coding sessions.\n\n[Set Root Path](command:scratches.setRootPath)",
        "when": "!config.scratches.path"
      }
    ],
    "commands": [
      {
        "command": "scratches.setRootPath",
        "title": "Scratches: Set Root Path..."
      },
      { "command": "scratches.selectWorkspaceFolder", "title": "Scratches: Select Project", "icon": "$(folder-opened)" },
      { "command": "scratches.compareWithClipboard", "title": "Scratches: Compare Active File with Clipboard" },
      { "command": "scratches.swapCompareSides", "title": "Scratches: Swap Compared Files" },
      { "command": "sectionProjectFiles.compareWithClipboard", "title": "Compare with Clipboard" },
      { "command": "sectionProjectFiles.selectForCompare", "title": "Select for Compare" },
      { "command": "sectionProjectFiles.compareWithSelected", "title": "Compare with Selected (select first file)", "enablement": "scratches.hasCompareSource" },
      { "command": "sectionProjectFiles.compareSelected", "title": "Compare Selected (select two files)", "enablement": "scratches.sectionProjectFiles.canCompareSelected" },
      { "command": "sectionSharedFiles.compareWithClipboard", "title": "Compare with Clipboard" },
      { "command": "sectionSharedFiles.selectForCompare", "title": "Select for Compare" },
      { "command": "sectionSharedFiles.compareWithSelected", "title": "Compare with Selected (select first file)", "enablement": "scratches.hasCompareSource" },
      { "command": "sectionSharedFiles.compareSelected", "title": "Compare Selected (select two files)", "enablement": "scratches.sectionSharedFiles.canCompareSelected" },
      { "command": "sectionAllFiles.compareWithClipboard", "title": "Compare with Clipboard" },
      { "command": "sectionAllFiles.selectForCompare", "title": "Select for Compare" },
      { "command": "sectionAllFiles.compareWithSelected", "title": "Compare with Selected (select first file)", "enablement": "scratches.hasCompareSource" },
      { "command": "sectionAllFiles.compareSelected", "title": "Compare Selected (select two files)", "enablement": "scratches.sectionAllFiles.canCompareSelected" },
      {
        "command": "extension.openMyView",
        "title": "Open My View"
      },
      {
        "command": "sectionProjectFiles.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "sectionProjectFiles.searchContent",
        "title": "Search File Contents...",
        "icon": "$(search)"
      },
      {
        "command": "sectionProjectFiles.newScratchFile",
        "title": "New Scratch File...",
        "icon": "$(new-file)"
      },
      {
        "command": "sectionProjectFiles.newFolder",
        "title": "New Folder...",
        "icon": "$(new-folder)"
      },
      {
        "command": "sectionProjectFiles.rename",
        "title": "Rename..."
      },
      {
        "command": "sectionProjectFiles.copyPath",
        "title": "Copy Path"
      },
      {
        "command": "sectionProjectFiles.copy",
        "title": "Copy"
      },
      {
        "command": "sectionProjectFiles.cut",
        "title": "Cut"
      },
      {
        "command": "sectionProjectFiles.paste",
        "title": "Paste"
      },
      {
        "command": "sectionProjectFiles.clear",
        "shortTitle": "Clear",
        "title": "Move all files from the root with a date in the name earlier than the specified date to the \"trash\" folder",
        "icon": "$(clear-all)"
      },
      {
        "command": "sectionProjectFiles.delete",
        "title": "Delete",
        "icon": "$(trash)"
      },
      {
        "command": "sectionSharedFiles.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "sectionSharedFiles.searchContent",
        "title": "Search File Contents...",
        "icon": "$(search)"
      },
      {
        "command": "sectionSharedFiles.newScratchFile",
        "title": "New Scratch File...",
        "icon": "$(new-file)"
      },
      {
        "command": "sectionSharedFiles.newFolder",
        "title": "New Folder...",
        "icon": "$(new-folder)"
      },
      {
        "command": "sectionSharedFiles.rename",
        "title": "Rename..."
      },
      {
        "command": "sectionSharedFiles.copyPath",
        "title": "Copy Path"
      },
      {
        "command": "sectionSharedFiles.copy",
        "title": "Copy"
      },
      {
        "command": "sectionSharedFiles.cut",
        "title": "Cut"
      },
      {
        "command": "sectionSharedFiles.paste",
        "title": "Paste"
      },
      {
        "command": "sectionSharedFiles.clear",
        "shortTitle": "Clear",
        "title": "Move all files from the root with a date in the name earlier than the specified date to the \"trash\" folder",
        "icon": "$(clear-all)"
      },
      {
        "command": "sectionSharedFiles.delete",
        "title": "Delete",
        "icon": "$(trash)"
      },
      {
        "command": "sectionAllFiles.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "sectionAllFiles.searchContent",
        "title": "Search File Contents...",
        "icon": "$(search)"
      },
      {
        "command": "sectionAllFiles.newScratchFile",
        "title": "New Scratch File...",
        "icon": "$(new-file)"
      },
      {
        "command": "sectionAllFiles.newFolder",
        "title": "New Folder...",
        "icon": "$(new-folder)"
      },
      {
        "command": "sectionAllFiles.rename",
        "title": "Rename..."
      },
      {
        "command": "sectionAllFiles.copyPath",
        "title": "Copy Path"
      },
      {
        "command": "sectionAllFiles.copy",
        "title": "Copy"
      },
      {
        "command": "sectionAllFiles.cut",
        "title": "Cut"
      },
      {
        "command": "sectionAllFiles.paste",
        "title": "Paste"
      },
      {
        "command": "sectionAllFiles.clear",
        "shortTitle": "Clear",
        "title": "Move all files from the root with a date in the name earlier than the specified date to the \"trash\" folder",
        "icon": "$(clear-all)"
      },
      {
        "command": "sectionAllFiles.delete",
        "title": "Delete",
        "icon": "$(trash)"
      }
    ],
    "keybindings": [
      {
        "command": "sectionProjectFiles.copy",
        "key": "ctrl+c",
        "when": "focusedView == sectionProjectFiles",
        "mac": "cmd+c"
      },
      {
        "command": "sectionProjectFiles.cut",
        "key": "ctrl+x",
        "when": "focusedView == sectionProjectFiles",
        "mac": "cmd+x"
      },
      {
        "command": "sectionProjectFiles.paste",
        "key": "ctrl+v",
        "when": "focusedView == sectionProjectFiles",
        "mac": "cmd+v"
      },
      {
        "command": "sectionProjectFiles.delete",
        "key": "ctrl+delete",
        "when": "focusedView == sectionProjectFiles",
        "mac": "cmd+backspace"
      },
      {
        "command": "sectionSharedFiles.copy",
        "key": "ctrl+c",
        "when": "focusedView == sectionSharedFiles",
        "mac": "cmd+c"
      },
      {
        "command": "sectionSharedFiles.cut",
        "key": "ctrl+x",
        "when": "focusedView == sectionSharedFiles",
        "mac": "cmd+x"
      },
      {
        "command": "sectionSharedFiles.paste",
        "key": "ctrl+v",
        "when": "focusedView == sectionSharedFiles",
        "mac": "cmd+v"
      },
      {
        "command": "sectionSharedFiles.delete",
        "key": "ctrl+delete",
        "when": "focusedView == sectionSharedFiles",
        "mac": "cmd+backspace"
      },
      {
        "command": "sectionAllFiles.copy",
        "key": "ctrl+c",
        "when": "focusedView == sectionAllFiles",
        "mac": "cmd+c"
      },
      {
        "command": "sectionAllFiles.cut",
        "key": "ctrl+x",
        "when": "focusedView == sectionAllFiles",
        "mac": "cmd+x"
      },
      {
        "command": "sectionAllFiles.paste",
        "key": "ctrl+v",
        "when": "focusedView == sectionAllFiles",
        "mac": "cmd+v"
      },
      {
        "command": "sectionAllFiles.delete",
        "key": "ctrl+delete",
        "when": "focusedView == sectionAllFiles",
        "mac": "cmd+backspace"
      }
    ],
    "views": {
      "scratchesTab": [
        {
          "id": "viewsWelcome",
          "name": "Welcome Scratches",
          "when": "!config.scratches.path"
        },
        {
          "id": "sectionProjectFiles",
          "name": "Project Files",
          "when": "config.scratches.path"
        },
        {
          "id": "sectionSharedFiles",
          "name": "Shared Files",
          "when": "config.scratches.path"
        },
        {
          "id": "sectionAllFiles",
          "name": "All Files",
          "when": "config.scratches.path"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        { "command": "sectionProjectFiles.compareWithClipboard", "when": "false" },
        { "command": "sectionProjectFiles.selectForCompare", "when": "false" },
        { "command": "sectionProjectFiles.compareWithSelected", "when": "false" },
        { "command": "sectionProjectFiles.compareSelected", "when": "false" },
        { "command": "sectionSharedFiles.compareWithClipboard", "when": "false" },
        { "command": "sectionSharedFiles.selectForCompare", "when": "false" },
        { "command": "sectionSharedFiles.compareWithSelected", "when": "false" },
        { "command": "sectionSharedFiles.compareSelected", "when": "false" },
        { "command": "sectionAllFiles.compareWithClipboard", "when": "false" },
        { "command": "sectionAllFiles.selectForCompare", "when": "false" },
        { "command": "sectionAllFiles.compareWithSelected", "when": "false" },
        { "command": "sectionAllFiles.compareSelected", "when": "false" },
        {
          "command": "sectionProjectFiles.newScratchFile",
          "when": "config.scratches.path"
        }
      ],
      "view/title": [
        { "command": "scratches.selectWorkspaceFolder", "when": "view == sectionProjectFiles", "group": "navigation@5" },
        { "command": "sectionProjectFiles.searchContent", "when": "view == sectionProjectFiles", "group": "navigation@4" },
        { "command": "sectionSharedFiles.searchContent", "when": "view == sectionSharedFiles", "group": "navigation@4" },
        { "command": "sectionAllFiles.searchContent", "when": "view == sectionAllFiles", "group": "navigation@4" },
        {
          "command": "sectionProjectFiles.newScratchFile",
          "when": "view == sectionProjectFiles",
          "group": "navigation@1"
        },
        {
          "command": "sectionProjectFiles.newFolder",
          "when": "view == sectionProjectFiles",
          "group": "navigation@2"
        },
        {
          "command": "sectionProjectFiles.clear",
          "when": "view == sectionProjectFiles",
          "group": "navigation@3"
        },
        {
          "command": "sectionProjectFiles.refresh",
          "when": "view == sectionProjectFiles",
          "group": "navigation@9"
        },
        {
          "command": "sectionSharedFiles.newScratchFile",
          "when": "view == sectionSharedFiles",
          "group": "navigation@1"
        },
        {
          "command": "sectionSharedFiles.newFolder",
          "when": "view == sectionSharedFiles",
          "group": "navigation@2"
        },
        {
          "command": "sectionSharedFiles.clear",
          "when": "view == sectionSharedFiles",
          "group": "navigation@3"
        },
        {
          "command": "sectionSharedFiles.refresh",
          "when": "view == sectionSharedFiles",
          "group": "navigation@9"
        },
        {
          "command": "sectionAllFiles.newScratchFile",
          "when": "view == sectionAllFiles",
          "group": "navigation@1"
        },
        {
          "command": "sectionAllFiles.newFolder",
          "when": "view == sectionAllFiles",
          "group": "navigation@2"
        },
        {
          "command": "sectionAllFiles.clear",
          "when": "view == sectionAllFiles",
          "group": "navigation@3"
        },
        {
          "command": "sectionAllFiles.refresh",
          "when": "view == sectionAllFiles",
          "group": "navigation@9"
        }
      ],
      "view/item/context": [
        { "command": "sectionProjectFiles.compareWithClipboard", "when": "view == sectionProjectFiles && viewItem == file", "group": "group_3@5" },
        { "command": "sectionProjectFiles.selectForCompare", "when": "view == sectionProjectFiles && viewItem == file", "group": "group_3@2" },
        { "command": "sectionProjectFiles.compareWithSelected", "when": "view == sectionProjectFiles && viewItem == file", "group": "group_3@3" },
        { "command": "sectionProjectFiles.compareSelected", "when": "view == sectionProjectFiles && viewItem == file", "group": "group_3@4" },
        { "command": "sectionSharedFiles.compareWithClipboard", "when": "view == sectionSharedFiles && viewItem == file", "group": "group_3@5" },
        { "command": "sectionSharedFiles.selectForCompare", "when": "view == sectionSharedFiles && viewItem == file", "group": "group_3@2" },
        { "command": "sectionSharedFiles.compareWithSelected", "when": "view == sectionSharedFiles && viewItem == file", "group": "group_3@3" },
        { "command": "sectionSharedFiles.compareSelected", "when": "view == sectionSharedFiles && viewItem == file", "group": "group_3@4" },
        { "command": "sectionAllFiles.compareWithClipboard", "when": "view == sectionAllFiles && viewItem == file", "group": "group_3@5" },
        { "command": "sectionAllFiles.selectForCompare", "when": "view == sectionAllFiles && viewItem == file", "group": "group_3@2" },
        { "command": "sectionAllFiles.compareWithSelected", "when": "view == sectionAllFiles && viewItem == file", "group": "group_3@3" },
        { "command": "sectionAllFiles.compareSelected", "when": "view == sectionAllFiles && viewItem == file", "group": "group_3@4" },
        {
          "command": "sectionProjectFiles.newScratchFile",
          "when": "view == sectionProjectFiles",
          "group": "group_0@1"
        },
        {
          "command": "sectionProjectFiles.newFolder",
          "when": "view == sectionProjectFiles",
          "group": "group_0@2"
        },
        {
          "command": "sectionProjectFiles.copy",
          "when": "view == sectionProjectFiles && (viewItem == file || viewItem == directory)",
          "group": "group_2@1"
        },
        {
          "command": "sectionProjectFiles.cut",
          "when": "view == sectionProjectFiles && (viewItem == file || viewItem == directory)",
          "group": "group_2@2"
        },
        {
          "command": "sectionProjectFiles.paste",
          "when": "view == sectionProjectFiles",
          "group": "group_2@3"
        },
        {
          "command": "sectionProjectFiles.copyPath",
          "when": "view == sectionProjectFiles",
          "group": "group_3@1"
        },
        {
          "command": "sectionProjectFiles.rename",
          "when": "view == sectionProjectFiles",
          "group": "group_4@0"
        },
        {
          "command": "sectionProjectFiles.delete",
          "when": "view == sectionProjectFiles",
          "group": "group_4@1"
        },
        {
          "command": "sectionSharedFiles.newScratchFile",
          "when": "view == sectionSharedFiles",
          "group": "group_0@1"
        },
        {
          "command": "sectionSharedFiles.newFolder",
          "when": "view == sectionSharedFiles",
          "group": "group_0@1"
        },
        {
          "command": "sectionSharedFiles.copy",
          "when": "view == sectionSharedFiles && (viewItem == file || viewItem == directory)",
          "group": "group_2@1"
        },
        {
          "command": "sectionSharedFiles.cut",
          "when": "view == sectionSharedFiles && (viewItem == file || viewItem == directory)",
          "group": "group_2@2"
        },
        {
          "command": "sectionSharedFiles.paste",
          "when": "view == sectionSharedFiles",
          "group": "group_2@3"
        },
        {
          "command": "sectionSharedFiles.copyPath",
          "when": "view == sectionSharedFiles",
          "group": "group_3@1"
        },
        {
          "command": "sectionSharedFiles.rename",
          "when": "view == sectionSharedFiles",
          "group": "group_4@0"
        },
        {
          "command": "sectionSharedFiles.delete",
          "when": "view == sectionSharedFiles",
          "group": "group_4@1"
        },
        {
          "command": "sectionAllFiles.newScratchFile",
          "when": "view == sectionAllFiles",
          "group": "group_0@1"
        },
        {
          "command": "sectionAllFiles.newFolder",
          "when": "view == sectionAllFiles",
          "group": "group_0@1"
        },
        {
          "command": "sectionAllFiles.copy",
          "when": "view == sectionAllFiles && (viewItem == file || viewItem == directory)",
          "group": "group_2@1"
        },
        {
          "command": "sectionAllFiles.cut",
          "when": "view == sectionAllFiles && (viewItem == file || viewItem == directory)",
          "group": "group_2@2"
        },
        {
          "command": "sectionAllFiles.paste",
          "when": "view == sectionAllFiles",
          "group": "group_2@3"
        },
        {
          "command": "sectionAllFiles.copyPath",
          "when": "view == sectionAllFiles",
          "group": "group_3@1"
        },
        {
          "command": "sectionAllFiles.rename",
          "when": "view == sectionAllFiles",
          "group": "group_4@0"
        },
        {
          "command": "sectionAllFiles.delete",
          "when": "view == sectionAllFiles",
          "group": "group_4@1"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "scratchesTab",
          "title": "Scratches",
          "icon": "res/build.svg"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "node ./scripts/run-tests.cjs"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.105.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vscode/test-electron": "^3.1.0",
    "eslint": "^10.15.0",
    "mocha": "^12.0.3",
    "typescript": "~6.0.0"
  }
}
